[Unit]
Description=blobdev %i: object storage as a block device
Documentation=https://github.com/myml/blobdev
After=network-online.target
Wants=network-online.target
# ublk_drv is a module on most kernels. Without this the service starts at
# boot before anything has loaded it, fails to create its device, and exits --
# well, it fails; the error used to blame a leftover device, which sent the
# reader somewhere else entirely.
After=systemd-modules-load.service
Wants=systemd-modules-load.service
# A start that fails for a configuration reason -- a missing EnvironmentFile, a
# misspelled flag -- will fail the same way every time, so retrying it is waste.
# These belong in [Unit]: put them in [Service] and systemd ignores them, which
# is how the first version of this was written.
StartLimitIntervalSec=60
StartLimitBurst=2

[Service]
Type=simple
# Loading the module here as well means the unit works on a machine where
# nobody has written /etc/modules-load.d/ublk.conf. modprobe is a no-op when
# it is already loaded.
ExecStartPre=-/sbin/modprobe ublk_drv
# The volume name selects /etc/blobdev/<volume>.conf for its settings.
EnvironmentFile=/etc/blobdev/%i.conf
ExecStart=/usr/local/bin/blobdev run $BLOBDEV_ARGS
# A flush on SIGTERM uploads every dirty chunk before exiting, and then the
# process ends immediately. The timeout is a backstop for a store that has
# stopped answering, not the expected duration.
KillSignal=SIGTERM
# Stopping uploads every dirty object first. With the default --timeout 60 and
# --retries 4, one object can take 241 s in the worst case (four attempts plus
# backoff), so 120 s was not enough to finish even one: the stop was SIGKILLed
# mid-upload whenever the store was slow. The data survives -- it is still in
# the working copy and the metadata -- but the stop is not clean and the next
# start uploads it again. Raise this if you raise --retries or --timeout.
TimeoutStopSec=300
Restart=on-failure
# A start that fails for a configuration reason -- a missing EnvironmentFile, a
# misspelled flag -- will fail the same way every time. systemd's own default
# limit only kicks in after five tries, which is 30+ seconds of retrying a typo
# and a log full of restarts. Two tries inside a minute, then stay failed so
# someone looks.
RestartSec=5s

# Sandboxing has to leave the device machinery alone.
#
# ublk makes a character device under /sys/class/ublk-char and a block node
# under /dev while the daemon runs. ProtectSystem=strict makes everything
# outside ReadWritePaths read-only, and adding /dev and /sys to that list was
# not enough -- the daemon logged a device, never got a node, and the service
# started and stopped again within a second with nothing in the log to say
# why. `full` protects /usr, /boot and /etc, which is what this wants, and
# leaves /dev and /sys alone.
#
# PrivateTmp gives the service its own /tmp, and that directory is thrown
# away when the unit stops. A volume whose metadata lives in /tmp therefore
# loses it and is recreated empty on the next start -- which looks exactly
# like data loss, because it is. See the warning in the comment below.
#
# Where the volume may keep its files.
#
# ProtectSystem=full leaves everything outside /usr, /boot and /etc writable,
# so --meta and --cache-dir work under /var/lib, /srv, /opt or /mnt without
# being listed here. What fails is a path inside /usr, /boot or /etc: the
# daemon reports "Read-only file system (os error 30)" and exits, which is a
# clear enough failure. PrivateTmp makes /tmp a private directory -- put the
# metadata somewhere it will still be after a restart.
#
# These two entries are here because they are where the example config puts
# things, not because they are the only places that work.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# Where the metadata and the disk cache may live. A volume pointed anywhere
# else -- --meta /srv/blob/my.meta, say -- fails at step NAMESPACE before
# blobdev runs a single line, with a message that names neither the directory
# nor the setting. Add the path here if you want it elsewhere.
ReadWritePaths=/var/lib/blobdev /var/cache/blobdev
NoNewPrivileges=true

# CAP_SYS_ADMIN creates the ublk device; CAP_SYS_MODULE lets the ExecStartPre
# above load the driver. modprobe fails with "Operation not permitted" without
# it, and the service then starts without a device.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_MODULE
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_MODULE

[Install]
WantedBy=multi-user.target
