[Unit]
Description=blobdev %i: object storage as a block device
Documentation=https://github.com/myml/blobdev
After=network-online.target
Wants=network-online.target
# ublk_drv is a module on most kernels. Without this the service starts at
# boot before anything has loaded it, fails to create its device, and exits --
# well, it fails; the error used to blame a leftover device, which sent the
# reader somewhere else entirely.
After=systemd-modules-load.service
Wants=systemd-modules-load.service

[Service]
Type=simple
# Loading the module here as well means the unit works on a machine where
# nobody has written /etc/modules-load.d/ublk.conf. modprobe is a no-op when
# it is already loaded.
ExecStartPre=-/sbin/modprobe ublk_drv
# The volume name selects /etc/blobdev/<volume>.conf for its settings.
EnvironmentFile=/etc/blobdev/%i.conf
ExecStart=/usr/local/bin/blobdev run $BLOBDEV_ARGS
# A flush on SIGTERM uploads every dirty chunk before exiting, and then the
# process ends immediately. The timeout is a backstop for a store that has
# stopped answering, not the expected duration.
KillSignal=SIGTERM
TimeoutStopSec=120
Restart=on-failure
RestartSec=5s

# Sandboxing has to leave the device machinery alone.
#
# ublk makes a character device under /sys/class/ublk-char and a block node
# under /dev while the daemon runs. ProtectSystem=strict makes everything
# outside ReadWritePaths read-only, and adding /dev and /sys to that list was
# not enough -- the daemon logged a device, never got a node, and the service
# started and stopped again within a second with nothing in the log to say
# why. `full` protects /usr, /boot and /etc, which is what this wants, and
# leaves /dev and /sys alone.
#
# --meta and --cache-dir still have to be under ReadWritePaths: ProtectSystem
# makes everything else read-only, and a metadata file that cannot be written
# is a volume that cannot recover after a restart.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/blobdev /var/cache/blobdev
NoNewPrivileges=true

# CAP_SYS_ADMIN creates the ublk device; CAP_SYS_MODULE lets the ExecStartPre
# above load the driver. modprobe fails with "Operation not permitted" without
# it, and the service then starts without a device.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_MODULE
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_MODULE

[Install]
WantedBy=multi-user.target
