[Unit]
Description=blobdev %i: object storage as a block device
Documentation=https://github.com/myml/blobdev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The volume name selects /etc/blobdev/<volume>.conf for its settings.
EnvironmentFile=/etc/blobdev/%i.conf
ExecStart=/usr/local/bin/blobdev run $BLOBDEV_ARGS
# A flush on SIGTERM uploads every dirty chunk before exiting, and then the
# process ends immediately. The timeout is a backstop for a store that has
# stopped answering, not the expected duration.
KillSignal=SIGTERM
TimeoutStopSec=120
Restart=on-failure
RestartSec=5s

# The process only needs its metadata file and cache directory, plus the
# block-device node it creates.
#
# ProtectSystem=strict makes everything outside ReadWritePaths read-only, so
# --meta and --cache-dir must live under one of those paths. A volume whose
# metadata is somewhere else needs that directory added here, or the daemon
# will fail to write it and the volume will be unable to recover after a
# restart.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/blobdev /var/cache/blobdev
NoNewPrivileges=true

# ublk needs CAP_SYS_ADMIN to create the device.
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
